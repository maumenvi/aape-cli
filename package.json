{
  "name": "@maumenvi/maia-cli",
  "version": "1.5.3",
  "description": "CLI for cataloging and installing skills, MCPs, and tools for AI agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "maia": "dist/src/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".env.maia.example",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "agent",
    "skills",
    "mcp",
    "typescript",
    "node",
    "catalog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maumenvi/maia-cli.git"
  },
  "homepage": "https://github.com/maumenvi/maia-cli",
  "bugs": {
    "url": "https://github.com/maumenvi/maia-cli/issues"
  },
  "scripts": {
    "dev": "node src/cli/index.ts",
    "maia": "node src/cli/index.ts",
    "build:publish": "node scripts/build-publish.mjs",
    "prepack": "npm run build:publish",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}