# Catálogos externos
SKILLS_REGISTRY_URL=https://skills.sh
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

# Opcional: aumenta o limite da API do GitHub ao resolver skills
GITHUB_TOKEN=

# Ambiente geral
NODE_ENV=development
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Tokens das LLMs e integrações opcionais
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
OPENROUTER_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Credenciais MCP exigidas por integrações de terceiros
# Elas são preenchidas em branco para que o projeto crie `.env.aape` com valores vazios
# quando ainda não existe.
