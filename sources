{
  "name": "aape",
  "version": "0.1.0",
  "aapeVersion": "^1.0.0",
  "config": {
    "registryStrategy": "hybrid",
    "strictVerify": true,
    "llmAccessDefault": "allow"
  },
  "registries": {
    "skills": {
      "provider": "skills.sh",
      "url": "https://skills.sh"
    },
    "mcp": {
      "provider": "mcp",
      "url": "https://registry.modelcontextprotocol.io"
    }
  },
  "sources": {
    "local": {
      "type": "git",
      "url": "https://github.com/maumenvi/aape.git",
      "ref": "master",
      "trusted": true
    },
    "skillsHub": {
      "type": "git",
      "url": "skillsHub",
      "ref": "main",
      "trusted": false
    },
    "custom-repo": {
      "type": "git",
      "url": "custom-repo",
      "ref": "main",
      "trusted": false
    }
  },
  "skills": {
    "skill-name": {
      "version": "*",
      "source": "local",
      "enabled": true,
      "capabilities": [],
      "constraints": [],
      "allowedLlms": [
        "*"
      ]
    },
    "test-skill": {
      "version": "*",
      "source": "local",
      "enabled": true,
      "capabilities": [],
      "constraints": [],
      "allowedLlms": [
        "*"
      ]
    }
  },
  "mcps": {},
  "tools": {}
}
