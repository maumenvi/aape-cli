# Copiar este arquivo para .env e preencher os valores reais.
# O projeto carrega as variáveis automaticamente via process.env.

# LLM providers
# Use OPEN_ROUTER_KEY quando quiser manter a variável com o mesmo nome do projeto.
OPEN_ROUTER_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Repositórios de descoberta padrão
# Esses endpoints são consultados quando o registry local não encontrar uma skill, tool ou MCP.
SKILLS_REPOSITORIES=https://www.skills.sh/
MCP_REPOSITORIES=https://mcpservers.org/pt-BR/

# Ambiente geral
NODE_ENV=development
